---
# Generated by `n8 capsule build {{name}}` — Iron Bank hardening manifest.
# Submit with the emitted Dockerfile + vendored source to Repo One
# (repo1.dso.mil/dsop). Point BASE_IMAGE/BASE_TAG at a real Iron Bank base
# before submission. The source is fully vendored, so `resources` is empty —
# nothing is fetched at build time. (Collections are flow-style: JSON is valid
# YAML, so this stays robust regardless of how many tags/labels/maintainers.)
apiVersion: v1
name: {{name}}
tags: {{tags}}
args:
  BASE_IMAGE: {{base_image_repo}}
  BASE_TAG: "{{base_image_tag}}"
labels: {{labels}}
resources: []
maintainers: {{maintainers}}
