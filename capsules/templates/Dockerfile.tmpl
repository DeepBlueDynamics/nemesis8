# Generated by `n8 capsule build {{name}}`. Iron Bank–hardenable capsule:
# non-root, single binary, built FULLY OFFLINE from vendored deps.
#
# Repo One's pipeline overrides BASE_IMAGE/BASE_TAG from the hardening manifest
# args; the defaults below are a stand-in so the bundle also builds locally with
# `docker build --network none` (no `# syntax=` directive on purpose — that would
# fetch a BuildKit frontend and defeat the offline build).
ARG BASE_IMAGE={{base_image_repo}}
ARG BASE_TAG={{base_image_tag}}

FROM {{builder_image}} AS build
WORKDIR /src
COPY . .
# Deps are vendored under ./vendor with .cargo/config.toml → no network needed.
RUN cargo build --release --offline --locked{{features_arg}} --bin {{binary}}

FROM ${BASE_IMAGE}:${BASE_TAG} AS runtime
{{labels_block}}COPY --from=build /src/target/release/{{binary}} /usr/local/bin/{{binary}}
{{env_block}}USER {{run_user}}
ENTRYPOINT ["{{binary}}"]
